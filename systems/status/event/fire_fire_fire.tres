[resource]
script = ExtResource("1_lu108")
id = "fire_fire_fire"
display_name = "Fire Fire Fire"
description = "A major fire broke out, but your factory was the first industry to be rescued, which cannot be said for the rest of the industrial district. The player's company receives a -10% penalty to the TOTAL value of the Labor attribute, while competing industries are penalized with -15% to the TOTAL value of the Labor attribute until the end of this stage"
